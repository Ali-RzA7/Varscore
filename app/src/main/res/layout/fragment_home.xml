<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ============================================================= -->
    <!-- HEADER ALANI: Toolbar + Toggle + Tarih Seçici                 -->
    <!-- ============================================================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            app:title="@string/app_name"
            app:titleTextColor="@color/white"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:layout_marginEnd="4dp">

                <!-- Arama Butonu -->
                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="@string/search_hint"
                    app:tint="@color/white" />

                <!-- Ayarlar Butonu -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_preferences"
                    android:contentDescription="@string/settings"
                    app:tint="@color/white" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- ============================================================= -->
        <!-- Toggle: Canlı / Tüm Maçlar                                     -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/carouselToggleContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#40FFFFFF"
                app:cardBackgroundColor="#1A000000">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <!-- Canlı Maçlar Butonu -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLiveMatches"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:text="@string/live_matches"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:letterSpacing="0.01"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="20dp"
                        app:backgroundTint="@android:color/transparent"
                        android:textColor="@color/white"
                        style="@style/Widget.MaterialComponents.Button.TextButton" />

                    <!-- Tüm Maçlar Butonu (varsayılan aktif) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAllMatches"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:text="@string/all_matches"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:letterSpacing="0.01"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="20dp"
                        app:backgroundTint="@color/secondary"
                        android:textColor="@color/on_secondary"
                        style="@style/Widget.MaterialComponents.Button" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ============================================================= -->
        <!-- Tarih Seçici                                                    -->
        <!-- ============================================================= -->
        <RelativeLayout
            android:id="@+id/datePickerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDatePicker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/date_picker_height"
                android:layout_toStartOf="@+id/btnOpenCalendar"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:overScrollMode="never" />

            <ImageButton
                android:id="@+id/btnOpenCalendar"
                android:layout_width="48dp"
                android:layout_height="@dimen/date_picker_height"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_today"
                android:contentDescription="@string/select_date"
                app:tint="@color/white" />

        </RelativeLayout>

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- İÇERİK: Maç Listesi + Durum Göstergeleri                      -->
    <!-- ============================================================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMatches"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="16dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Yükleniyor -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackThickness="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/loading"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <!-- Boş Durum -->
        <LinearLayout
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/padding_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/no_matches"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_subtitle"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- Hata Durumu -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/padding_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😕"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/error_loading"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_subtitle"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/retry"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
