<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================== -->
<!-- fragment_home.xml - Ana sayfa fragment layout'u                        -->
<!-- Yapı (yukarıdan aşağıya):                                             -->
<!--   1. Custom Toolbar (app adı + search + ayarlar)                      -->
<!--   2. Carousel Toggle (Canlı / Tüm Maçlar geçiş butonları)            -->
<!--   3. Horizontal Date Picker (yatay kaydırılabilir takvim)             -->
<!--   4. SwipeRefreshLayout > RecyclerView (maç listesi)                  -->
<!--   5. Loading/Error/Empty durumları                                    -->
<!-- ===================================================================== -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- ============================================================= -->
    <!-- BÖLÜM 1: Özel Toolbar - Uygulama adı, arama ve ayarlar       -->
    <!-- ============================================================= -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="?attr/colorPrimary"
        android:elevation="@dimen/elevation_md"
        app:title="@string/app_name"
        app:titleTextColor="@color/white"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6">

        <!-- Arama Butonu -->
        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@string/search_hint"
            app:tint="@color/white" />

        <!-- Ayarlar Butonu -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_preferences"
            android:contentDescription="@string/settings"
            app:tint="@color/white" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============================================================= -->
    <!-- BÖLÜM 2: Carousel Toggle - Canlı / Tüm Maçlar slider buton  -->
    <!-- Tasarım: İki segment buton (pill shape) - aktif olan vurgulanır -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/carouselToggleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="@dimen/padding_md"
        android:paddingBottom="@dimen/padding_sm"
        android:background="?attr/colorPrimary">

        <!-- Segment butonlar için kapsayıcı (pill shape) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/carousel_toggle_height"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary_dark">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="3dp">

                <!-- Canlı Maçlar Butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveMatches"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/live_matches"
                    android:textSize="@dimen/text_body_small"
                    android:textAllCaps="false"
                    android:minWidth="130dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@android:color/transparent"
                    android:textColor="@color/white"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

                <!-- Tüm Maçlar Butonu (varsayılan aktif) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllMatches"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/all_matches"
                    android:textSize="@dimen/text_body_small"
                    android:textAllCaps="false"
                    android:minWidth="130dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="18dp"
                    app:backgroundTint="@color/secondary"
                    android:textColor="@color/on_secondary"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- BÖLÜM 3: Horizontal Date Picker - Yatay kaydırılabilir takvim -->
    <!-- RecyclerView ile sonsuz scroll benzeri tarih seçici            -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/datePickerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:paddingBottom="@dimen/padding_md">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDatePicker"
            android:layout_width="match_parent"
            android:layout_height="@dimen/date_picker_height"
            android:clipToPadding="false"
            android:paddingStart="@dimen/padding_sm"
            android:paddingEnd="@dimen/padding_sm"
            android:overScrollMode="never" />

    </LinearLayout>

    <!-- ============================================================= -->
    <!-- BÖLÜM 4: Maç Listesi - SwipeRefreshLayout ile yenileme       -->
    <!-- Lig bazında gruplu RecyclerView                                -->
    <!-- ============================================================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Pull-to-refresh ile maç listesi yenileme -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMatches"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/padding_sm"
                android:paddingBottom="@dimen/padding_sm" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- ===================================================== -->
        <!-- Loading Durumu - Veriler yüklenirken gösterilir        -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="?attr/colorPrimary"
                app:trackThickness="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/loading"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- Boş Durum - Maç bulunamadığında gösterilir             -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/emptyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/padding_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/no_matches"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_subtitle"
                android:textAlignment="center" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- Hata Durumu - API hatası olduğunda gösterilir          -->
        <!-- ===================================================== -->
        <LinearLayout
            android:id="@+id/errorContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="@dimen/padding_xl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😕"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/error_loading"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="@dimen/text_subtitle"
                android:textAlignment="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_md"
                android:text="@string/retry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
