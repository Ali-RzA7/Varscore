<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_league_standings.xml - Bir ligin puan tablosu ekranı -->
<!-- Yapı: Toolbar + Tablo başlığı + Takım satırları RecyclerView -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- AppBar: Geri butonu + Lig adı -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:elevation="@dimen/elevation_sm">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@android:color/white"
            app:title="@string/nav_standings"
            app:titleTextColor="@android:color/white">

            <!-- Favori lig butonu (toolbar'ın sağında) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFavorite"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/margin_sm"
                android:minWidth="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_star"
                app:iconSize="@dimen/icon_md"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/secondary" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- İçerik -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Puan tablosu sütun başlıkları -->
        <LinearLayout
            android:id="@+id/headerRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@color/primary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/padding_md">

            <!-- Sıra sütunu başlığı -->
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="#"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- Takım sütunu başlığı -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="@dimen/padding_sm"
                android:text="@string/team"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- O: Oynanan -->
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="O"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- G: Galibiyet -->
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="G"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- B: Beraberlik -->
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="B"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- M: Mağlubiyet -->
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="M"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- A: Averaj (Gol farkı) -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="A"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <!-- P: Puan -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Ince ayırıcı çizgi -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline" />

        <!-- Puan tablosu içerik alanı -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Takım satırları -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStandings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <!-- Yükleniyor -->
            <LinearLayout
                android:id="@+id/loadingContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary" />

            </LinearLayout>

            <!-- Boş / Hata durumu -->
            <LinearLayout
                android:id="@+id/emptyContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_standings"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_subtitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_md"
                    android:text="@string/retry" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
