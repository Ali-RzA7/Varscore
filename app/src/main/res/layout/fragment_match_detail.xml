<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ============================================================= -->
    <!-- Üst Header Alanı (Sticky Header)                              -->
    <!-- ============================================================= -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="48dp"
                android:paddingBottom="24dp"
                android:paddingHorizontal="16dp">

                <!-- Takımlar ve Skor Alanı -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Ev Sahibi -->
                    <LinearLayout
                        android:id="@+id/llHomeTeam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/llScore"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivHomeLogo"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_launcher_background" />

                        <TextView
                            android:id="@+id/tvHomeName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/home"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Skor Alanı -->
                    <LinearLayout
                        android:id="@+id/llScore"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 - 0"
                            android:textColor="@color/secondary"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/status_finished"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvMatchTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="21:45"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:alpha="0.8" />
                    </LinearLayout>

                    <!-- Deplasman -->
                    <LinearLayout
                        android:id="@+id/llAwayTeam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_toEndOf="@+id/llScore"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivAwayLogo"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_launcher_background" />

                        <TextView
                            android:id="@+id/tvAwayName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/away"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center" />
                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

            <!-- Toolbar (Back button, Share vb.) -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Tab Alanı -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/primary_dark"
            app:tabGravity="fill"
            app:tabMode="fixed"
            app:tabIndicatorColor="@color/secondary"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorGravity="bottom"
            app:tabSelectedTextColor="@color/secondary"
            app:tabTextColor="#99FFFFFF"
            app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content (ViewPager) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- AI Tahmin FAB: Sadece giriş yapmış kullanıcılara gösterilir -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAiPrediction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/ai_prediction"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="gone"
        app:icon="@drawable/ic_ai"
        app:iconTint="@color/secondary"
        app:backgroundTint="@color/primary"
        app:elevation="6dp"
        app:cornerRadius="28dp"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
