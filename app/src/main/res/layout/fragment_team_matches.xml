<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_team_matches.xml - Takım detay sayfası: collapsing header + tab maçlar/kadro -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- AppBar: Collapsing hero + TabLayout -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:elevation="0dp">

        <!-- Collapsing toolbar: hero alanı + toolbar -->
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/primary"
            app:expandedTitleMarginStart="200dp"
            app:expandedTitleTextAppearance="@android:style/TextAppearance.DeviceDefault.Small">

            <!-- Hero içeriği: takım logosu, adı, mekan, antrenör, kuruluş yılı, form -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/primary"
                app:layout_collapseMode="parallax">

                <!-- Takım logosu -->
                <ImageView
                    android:id="@+id/ivTeamLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_team_logo_circle"
                    android:padding="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="24dp" />

                <!-- Takım adı -->
                <TextView
                    android:id="@+id/tvTeamName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/ivTeamLogo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivTeamLogo"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="16dp" />

                <!-- Stadyum -->
                <TextView
                    android:id="@+id/tvTeamVenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/tvTeamName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTeamName"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp" />

                <!-- Antrenör -->
                <TextView
                    android:id="@+id/tvTeamCoach"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="@id/tvTeamName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTeamVenue"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp" />

                <!-- Kuruluş yılı -->
                <TextView
                    android:id="@+id/tvTeamFounded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/secondary"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/tvTeamName"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTeamCoach"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="16dp" />

                <!-- Form göstergesi (son 5 maç) -->
                <LinearLayout
                    android:id="@+id/llForm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="start|center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="12dp" />

                <!-- Gol Sesi Özelleştirme Kartı -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGoalSound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#55000000"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#55FFFFFF"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp">

                        <!-- Başlık satırı: ikon + etiket + durum -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔊"
                                android:textSize="13sp"
                                android:layout_marginEnd="5dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gol Sesi"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tvGoalSoundStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Varsayılan"
                                android:textColor="#FFC107"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Buton satırı -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlayGoalSound"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:text="▶ Dinle"
                                android:textSize="10sp"
                                android:textColor="@android:color/white"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                app:strokeColor="#88FFFFFF"
                                app:cornerRadius="6dp" />

                            <View
                                android:layout_width="6dp"
                                android:layout_height="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnChangeGoalSound"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:text="Değiştir"
                                android:textSize="10sp"
                                android:textColor="#FFC107"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                app:cornerRadius="6dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Collapse olduğunda görünen toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back"
                app:navigationIconTint="@android:color/white"
                app:titleTextColor="@android:color/white">

                <!-- Favori butonu -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavorite"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginEnd="4dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_star"
                    app:iconSize="24dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/secondary" />

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Tab bar: Maçlar / Kadro -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            app:tabIndicatorColor="@color/secondary"
            app:tabSelectedTextColor="@android:color/white"
            app:tabTextColor="#B3FFFFFF"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="#33FFC107"
            android:paddingBottom="0dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager2: Tab içerikleri -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
