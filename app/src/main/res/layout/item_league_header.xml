<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leagueHeaderContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Lig renk göstergesi (dikey çizgi, yuvarlatılmış) -->
    <View
        android:id="@+id/viewLeagueColor"
        android:layout_width="4dp"
        android:layout_height="22dp"
        android:background="@drawable/shape_league_indicator"
        android:layout_marginEnd="10dp" />

    <!-- Lig adı -->
    <TextView
        android:id="@+id/tvLeagueName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13.5sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Favori lig yıldızı -->
    <TextView
        android:id="@+id/tvFavoriteStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="★"
        android:textSize="14sp"
        android:textColor="?attr/colorSecondary"
        android:visibility="gone" />

    <!-- Lig tipi ikonu (Lig/Kupa) -->
    <TextView
        android:id="@+id/tvLeagueType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
