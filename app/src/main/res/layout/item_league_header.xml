<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================================== -->
<!-- item_league_header.xml - Lig başlık öğesi                             -->
<!-- Maç listesinde ligleri gruplamak için kullanılır                       -->
<!-- Lig renk çizgisi + Lig adı gösterilir                                 -->
<!-- ===================================================================== -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/leagueHeaderContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/padding_lg"
    android:paddingEnd="@dimen/padding_lg"
    android:paddingTop="@dimen/padding_md"
    android:paddingBottom="@dimen/padding_sm"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Lig renk göstergesi (dikey çizgi) -->
    <View
        android:id="@+id/viewLeagueColor"
        android:layout_width="4dp"
        android:layout_height="20dp"
        android:background="?attr/colorPrimary" />

    <!-- Lig adı -->
    <TextView
        android:id="@+id/tvLeagueName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margin_sm"
        android:textSize="@dimen/text_body"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Favori lig yıldızı -->
    <TextView
        android:id="@+id/tvFavoriteStar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="★"
        android:textSize="14sp"
        android:textColor="?attr/colorSecondary"
        android:visibility="gone" />

    <!-- Lig tipi ikonu (Lig/Kupa) -->
    <TextView
        android:id="@+id/tvLeagueType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_caption"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
