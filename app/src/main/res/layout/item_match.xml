<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMatch"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:strokeWidth="0dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="13dp"
        android:paddingBottom="13dp">

        <!-- Sol: Maç saati / canlı gösterge -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Canlı maç göstergesi (glow nokta) -->
            <View
                android:id="@+id/viewLiveIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginBottom="3dp"
                android:background="@drawable/shape_live_dot"
                android:visibility="gone" />

            <!-- Saat veya canlı dakika -->
            <TextView
                android:id="@+id/tvMatchTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"
                android:letterSpacing="0.02" />

            <!-- Maç durumu (CANLI / Bitti) -->
            <TextView
                android:id="@+id/tvMatchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/live_red"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Dikey ayraç -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5"
            android:layout_marginEnd="12dp" />

        <!-- Orta: Takım adları ve skor -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Ev sahibi satırı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/viewHomeRedCard"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/red_card"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivHomeLogo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="centerInside"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHomeName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14.5sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvHomeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Deplasman satırı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="5dp">

                <View
                    android:id="@+id/viewAwayRedCard"
                    android:layout_width="3dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/red_card"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivAwayLogo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="centerInside"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvAwayName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14.5sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvAwayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sağ: Favori yıldız + Chevron -->
        <TextView
            android:id="@+id/tvTeamFavoriteStar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:text="★"
            android:textSize="13sp"
            android:textColor="?attr/colorSecondary"
            android:visibility="gone" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_chevron_right"
            android:alpha="0.25"
            android:contentDescription="@string/match_details"
            app:tint="?android:attr/textColorSecondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
