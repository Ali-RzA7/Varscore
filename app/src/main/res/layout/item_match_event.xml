<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6dp">

    <!-- Orta: Dakika Rozeti -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_event_time"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Dikey zaman çizgisi -->
    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:background="?attr/colorOutlineVariant" />

    <!-- Ev Sahibi Olayı (sol) -->
    <LinearLayout
        android:id="@+id/llHomeEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/tvTime"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingEnd="10dp"
        android:visibility="visible">

        <!-- Oyuncu adı + alt bilgi (gol tipi, değişiklik) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvHomePlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHomeSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivHomeEventType"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Deplasman Olayı (sağ) -->
    <LinearLayout
        android:id="@+id/llAwayEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/tvTime"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingStart="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivAwayEventType"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp" />

        <!-- Oyuncu adı + alt bilgi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAwayPlayer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvAwaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
