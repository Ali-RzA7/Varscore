<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <!-- SOL: Ev sahibi olayı -->
    <LinearLayout
        android:id="@+id/llHomeEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingEnd="8dp">

        <!-- Metin bloğu: tüm boş alanı kapla, sağa hizalı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="6dp">

            <!-- Çıkan oyuncu (veya gol atan) -->
            <TextView
                android:id="@+id/tvHomePlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"
                android:maxLines="2" />

            <!-- Giren oyuncu / olay etiketi -->
            <TextView
                android:id="@+id/tvHomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:gravity="end"
                android:visibility="gone"
                android:maxLines="2" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivHomeEventType"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- ORTA: Dakika chip -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="52dp"
        android:layout_height="26dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:background="@drawable/bg_minute_chip" />

    <!-- SAĞ: Deplasman olayı -->
    <LinearLayout
        android:id="@+id/llAwayEvent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingStart="8dp"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/ivAwayEventType"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:scaleType="fitCenter"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Çıkan oyuncu (veya gol atan) -->
            <TextView
                android:id="@+id/tvAwayPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2" />

            <!-- Giren oyuncu / olay etiketi -->
            <TextView
                android:id="@+id/tvAwaySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:visibility="gone"
                android:maxLines="2" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
